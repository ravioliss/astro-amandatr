---
import Layout from '../layouts/layout.astro'

import { getLocale, useTranslations } from '../i18n/utils.ts'

import { Image } from 'astro:assets';
import fotoNivelAlto from '../assets/nivel-alto.jpg';

const currentLang = getLocale(Astro.currentLocale)
const translateLabels = useTranslations(currentLang)

---

<Layout title="Página de Contacto"
description='Portfolio de Amanda Torres Rodríguez, artista visual y desarrolladora. Pintura, gráfica original, diseño editorial, gráfico y UX/web.'>

<main>
  <h3> {translateLabels("nav.contacto")} </h3>

    
    <div class=" card-contacto-container"> 

      <article class="main-article">
        <div class="text">
          <h1> Hola soy Amanda Torres</h1>
          <h2>Artista visual, investigadora, y diseñadora web</h2>
          <p>
            Soy una artista visual con más de 10 años de experiencia en
            conceptualización, creación y colaboración de proyectos creativos.
            Mi trayectoria profesional se define por el cruce de prácticas
            artísticas y el ecosistema digital. Disfruto de transformar
            conceptos abstractos a experiencias tangibles. Me considero una
            persona colaborativa, curiosa, comunicativa, trabajadora y empática. ¡Colaboremos!
            <a href=""></a>
          </p>
