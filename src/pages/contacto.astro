          </ul>
        </div>

        <Image src={fotoNivelAlto} alt="foto portrait con el cabello suelto" />
      </article>
    </div>
    

       
          <form action="https://api.web3forms.com/submit" method="POST">
            <input
              type="hidden"
              name="access_key"
              value="80e25eee-db78-42ac-8814-274a43f37491"
            />
            <label for="name">Nombre:</label> <br />
            <input type="text" name="name" placeholder="Tu nombre" required /> <br />
            <label for="email" >Correo:</label> <br />
            <input type="email" placeholder="Tu email" name="email" required /> <br />
            <label for="message">Mensaje:</label> <br />
            <textarea name="message" placeholder="Lo que me quieras escribir" required></textarea>
            <br />
            <div class="h-captcha" data-captcha="true"></div>
            <button class="btn-form" type="submit">Enviar</button>
          </form>
      
    </main>

</Layout>

<style>
  .main-article {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  text-align: center;
}

.main-article img {
  margin: auto;
  object-fit: fill;
  object-position: top;
  height: auto;
  width: 300px;
  overflow: hidden;
  margin: 0 auto;
}

.icons {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2rem;
}

ul svg {
  width: 36px;
  height: 36px;
}

.social {
  fill: #4b1d3f;
}

.social:hover {
  fill: var(--blackberry-claro);
}

@media (min-width: 750px) {
  :root {
    --base-font-size: 1.125rem;
  }
  .wrapper {
    padding: 5rem;
  }

  .main-article {
    grid-template-columns: 1fr 1fr;
    align-items: center;
    text-align: left;
  }
  .main-article img {
    max-width: 300px;
    margin: 0 0 0 auto;
    height: auto;
    width: auto;
    object-fit: fill;
    overflow: auto;
  }
  .icons {
    justify-content: flex-start;
  }
}
</style>