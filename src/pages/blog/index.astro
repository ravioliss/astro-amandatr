---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/layout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Blog"
  description="Portfolio de Amanda Torres Rodríguez, artista visual y desarrolladora. Pintura, gráfica original, diseño editorial, gráfico y UX/web."
>
  <h1>Amanda Torres</h1>
  <h3>Blog</h3>
  <h3>Categorías</h3>

  <ul class="categorias blog">
    <li class="categorias__item rosa"> <button>Filosofía</button></li>
    <li class="categorias__item azul"> <button>Crítica</button></li>
    <li class="categorias__item verde"> <button>Cultura</button></li>
    <li class="categorias__item anarajado"> <button>Eventos</button></li>
    <li class="categorias__item rojo"> <button>Reseñas</button></li>
    <li class="categorias__item violeta"> <button>Cine</button></li>
  </ul>

  <!-- 👇 AQUÍ VA EL LISTADO REAL -->
  <section class="lista-posts">
    {posts.length === 0 && <p>Todavía no hay posts publicados.</p>}

    {posts.map(post => (
      <article class="post-item">
        <h2>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
        </h2>
        <time>{post.data.date.toLocaleDateString('es-ES')}</time>
        <p>{post.data.summary}</p>
        {post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map(tag => <li>{tag}</li>)}
          </ul>
        )}
      </article>
    ))}
  </section>
</Layout>