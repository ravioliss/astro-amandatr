---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Portfolio de arte de Amanda Torres",
  image,
} = Astro.props;

---

<!doctype html>
<html lang= "es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <title>{title}</title>
    <link rel="canonical" href="https://amandatr.com/" />
    <link rel="icon" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Amanda Torres Rodríguez",
      "url": "https://amandatr.com",
      "jobTitle": "Artista visual ",
      "sameAs": [
        "https://github.com/ravioliss",
        "https://www.behance.net/amandatr-me",
        "https://www.linkedin.com/in/amandagtr"
      ],
      "knowsAbout": [
        "Pintura",
        "Gráfica",
        "Diseño editorial",
        "Video"
      ],
      "description": "Portfolio de Amanda Torres Rodríguez, artista visual especializada en gráfica original, diseño editorial y diseño web."
    })} />

    <!-- HTML Meta Tags -->
<title>Amanda Torres</title>
<meta name="description" content="Portfolio de Amanda Torres Rodríguez, artista visual especializada en gráfica original, diseño editorial y diseño web.">

<!-- Open Graph Meta Tags -->
<meta property="og:url" content="http://amandatr.com">
<meta property="og:type" content="website">
<meta property="og:title" content="Amanda Torres">
<meta property="og:description" content="Portfolio de Amanda Torres Rodríguez, artista visual especializada en gráfica original, diseño editorial y diseño web.">
<meta property="og:image" content="/assets/grafica/aqui/aquiportada.jpg"> 

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta property="twitter:domain" content="amandatr.com">
<meta property="twitter:url" content="http://amandatr.com">
<meta name="twitter:title" content="Amanda Torres">
<meta name="twitter:description" content="Portfolio de Amanda Torres Rodríguez, artista visual especializada en gráfica original, diseño editorial y diseño web.">
<meta name="twitter:image" content="/assets/grafica/aqui/aquiportada.jpg"> 

<!-- Meta Tags Generated via https://opengraph.dev -->

<link rel="preconnect" href="https://fonts.bunny.net" />
<link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
<link href="https://fonts.bunny.net/css2?family=Afacad:ital,wght@0,400..700;1,400..700&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />

</head>

  <body>
    <Header />

    <main>
      <div class="container">
      <slot />
    </div>
    </main>

    <Footer />
  </body>
</html>