---
import SealSpinner from '../components/sealspinner.astro' 
import '../styles/global.css';
import { getLocale, languages, useTranslations } from '../i18n/utils.ts';
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLang = getLocale(Astro.currentLocale);
const aboutURL = getRelativeLocaleUrl(currentLang, "contacto");
const indexURL = getRelativeLocaleUrl(currentLang, "/");
const blogURL = getRelativeLocaleUrl(currentLang, "blog");

const translateLabels = useTranslations(currentLang);
---

<header>


<nav>
			<figure>
		<SealSpinner /> 
	</figure>
	<div class="right-nav">
	
	<ul class="idiomas text-sm">
	{Object.entries(languages).map(([key, label] : [string, string]) => {
		return (	
	<li><a href={`/${key}`}>{label}</a></li>
	)
	})}
	</ul>


	<ul class="menu text-lg">
		<li>
			<a class="link-nav " href={indexURL}> {translateLabels("nav.home")} </a>
		</li>
		
		<li>
			<a class="link-nav"
				
				href="https://madeinchina.bigcartel.com/"
				rel="noopener"
				target="_blank"
				>{translateLabels("nav.tienda")}</a
			>
		</li>
		<li  class="contacto link-nav p-2  rounded-full hover:px-6  transition-all duration-300"><a  href={aboutURL}> {translateLabels("nav.contacto")}</a></li>
	</ul> 
	</div>
</nav>

</header>